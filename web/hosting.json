{
  "//": "A fragment, not a firebase.json. The coordinator merges the `hosting` object below into firebase/firebase.json (this agent does not edit firebase/). The exact changes are listed in docs/agent-notes/web.md. `public` is relative to the repository root. The mock server and the Playwright suite read the same `headers` and `rewrites`, so what is tested is what is deployed. Every `/api/{function}` rewrite is one Cloud Function in the region of D29; add a line here when a public function is added.",
  "hosting": {
    "public": "web/dist",
    "cleanUrls": false,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; manifest-src 'none'; object-src 'none'"
          },
          { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
          {
            "key": "Permissions-Policy",
            "value": "accelerometer=(), autoplay=(), camera=(), clipboard-read=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
          },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/m/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/p/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/api/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/fonts/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "/.well-known/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [
      { "source": "/api/getPublicPage", "function": { "functionId": "getPublicPage", "region": "europe-west1" } },
      { "source": "/api/getSlots", "function": { "functionId": "getSlots", "region": "europe-west1" } },
      { "source": "/api/holdSlot", "function": { "functionId": "holdSlot", "region": "europe-west1" } },
      { "source": "/api/createBooking", "function": { "functionId": "createBooking", "region": "europe-west1" } },
      { "source": "/api/joinWaitlist", "function": { "functionId": "joinWaitlist", "region": "europe-west1" } },
      { "source": "/api/sendEmailCode", "function": { "functionId": "sendEmailCode", "region": "europe-west1" } },
      { "source": "/api/verifyEmailCode", "function": { "functionId": "verifyEmailCode", "region": "europe-west1" } },
      { "source": "/api/findBookings", "function": { "functionId": "findBookings", "region": "europe-west1" } },
      { "source": "/api/getFormContext", "function": { "functionId": "getFormContext", "region": "europe-west1" } },
      { "source": "/api/submitSealed", "function": { "functionId": "submitSealed", "region": "europe-west1" } },
      { "source": "/api/getPortal", "function": { "functionId": "getPortal", "region": "europe-west1" } },
      { "source": "/api/getBooking", "function": { "functionId": "getBooking", "region": "europe-west1" } },
      { "source": "/api/confirmPresence", "function": { "functionId": "confirmPresence", "region": "europe-west1" } },
      { "source": "/api/reportLate", "function": { "functionId": "reportLate", "region": "europe-west1" } },
      { "source": "/api/rescheduleBooking", "function": { "functionId": "rescheduleBooking", "region": "europe-west1" } },
      { "source": "/api/requestReschedule", "function": { "functionId": "requestReschedule", "region": "europe-west1" } },
      { "source": "/api/cancelBooking", "function": { "functionId": "cancelBooking", "region": "europe-west1" } },
      { "source": "/api/rebook", "function": { "functionId": "rebook", "region": "europe-west1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
