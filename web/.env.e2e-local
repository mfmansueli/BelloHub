# The build scripts/e2e-local.sh runs against the REAL functions in the Firebase emulators, served by the Hosting
# emulator with the /api rewrites of firebase/firebase.json (npm run build:e2e-local). Unlike .env.e2e there is no
# mock: the phone verifier is the production one (Firebase Auth), which the page's own CSP keeps from reaching the
# Auth emulator, so the end-to-end flow verifies by email (the emulator's code is 123456). Nothing here is a secret.
VITE_API_BASE_URL=/api
VITE_SMS_VERIFIER=firebase
VITE_APP_CHECK=off
