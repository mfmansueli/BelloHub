# The build scripts/e2e-local.sh runs against the REAL functions in the Firebase emulators, served by the Hosting
# emulator with the /api rewrites of firebase/firebase.json (npm run build:e2e-local). There is no mock; the client
# verifies by e-mail code (the emulator's code is 123456). Nothing here is a secret.
VITE_API_BASE_URL=/api
