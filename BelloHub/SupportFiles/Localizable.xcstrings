    "services.delete.message" : {
      "comment" : "Message of the delete-service dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تحتفظ المواعيد التي استخدمتها باسمها. لا يتغيّر شيء في أي سجل. لإيقاف تقديمها دون حذفها، أوقفها بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termine, die sie genutzt haben, behalten ihren Namen. In keiner Akte ändert sich etwas. Wenn Sie sie nur nicht mehr anbieten wollen, schalten Sie sie stattdessen aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appointments that used it keep its name. Nothing in a client's record changes. To stop offering it without deleting it, switch it off instead."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Appointments that used it keep its name. Nothing in a client's record changes. To stop offering it without deleting it, switch it off instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las citas que lo usaron conservan su nombre. Nada en la ficha de nadie cambia. Para dejar de ofrecerlo sin eliminarlo, desactívalo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las citas que lo usaron conservan su nombre. Nada en la ficha de nadie cambia. Para dejar de ofrecerlo sin eliminarlo, desactívalo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las citas que lo usaron conservan su nombre. Nada en la ficha de nadie cambia. Para dejar de ofrecerlo sin eliminarlo, desactívalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rendez-vous qui l'ont utilisée en gardent le nom. Aucune fiche ne change. Pour ne plus la proposer sans la supprimer, désactivez-la."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जिन अपॉइंटमेंट में यह सेवा थी, उनमें इसका नाम बना रहता है। किसी की फ़ाइल में कुछ नहीं बदलता। हटाए बिना इसे देना बंद करना हो तो इसे बंद कर दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Janji temu yang memakainya tetap menyimpan namanya. Tidak ada catatan yang berubah. Untuk berhenti menawarkannya tanpa menghapus, nonaktifkan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gli appuntamenti che lo hanno usato ne mantengono il nome. Nelle schede non cambia nulla. Per smettere di offrirlo senza eliminarlo, disattivalo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os agendamentos que usaram esse serviço mantêm o nome. Nada na ficha de ninguém muda. Para parar de oferecê-lo sem excluir, desative-o."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As marcações que o usaram mantêm o nome. Nada na ficha de ninguém muda. Para deixar de o oferecer sem o eliminar, desative-o."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu hizmeti kullanan randevular adını korur. Hiçbir kayıtta değişiklik olmaz. Silmeden sunmayı bırakmak için bunun yerine kapatın."
          }
        }
      }
    },
