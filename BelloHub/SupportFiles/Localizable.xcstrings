        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आप इस रिकॉर्ड को अभी 24 घंटे तक संपादित कर सकती हैं। उसके बाद यह लॉक हो जाता है, और सुधार संपादन इतिहास में रहते हैं।"
