          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Changes save automatically. Bookings already made keep the rules they were made under."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los cambios se guardan automáticamente. Las reservas ya hechas conservan las reglas con las que se hicieron."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
