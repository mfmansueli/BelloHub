        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ के लिए आपकी सीमा पूरी हो गई। अब से उनकी ऑनलाइन बुकिंग के लिए आपकी मंज़ूरी चाहिए।"
