    "treatmentFlow.saved.lock.message" : {
      "comment" : "Saved: the 24-hour lock, in plain words",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ما زال بإمكانك تعديل هذا السجل خلال 24 ساعة. بعدها يُقفل، وتبقى التصحيحات في سجل التعديلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kannst diesen Eintrag noch 24 Stunden lang bearbeiten. Danach wird er gesperrt, und Korrekturen bleiben in einem Änderungsverlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can still edit this record for 24 hours. After that it locks, and corrections stay in an edit trail."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "You can still edit this record for 24 hours. After that it locks, and corrections stay in an edit trail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aún puedes editar este registro durante 24 horas. Después se bloquea y las correcciones quedan en un historial de ediciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aún puedes editar este registro durante 24 horas. Después se bloquea y las correcciones quedan en un historial de ediciones."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aún puedes editar este registro durante 24 horas. Después se bloquea y las correcciones quedan en un historial de ediciones."
