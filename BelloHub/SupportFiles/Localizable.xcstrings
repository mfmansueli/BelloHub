    "quickReplies.default.aftercare.text" : {
      "comment" : "Built-in reply: general aftercare advice after a visit. Keep {name} {service}.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مرحبًا {name}! بعد {service}: يُرجى المحافظة على نظافة المنطقة وتجنّب الحرارة وأشعة الشمس المباشرة اليوم، ومراسلتي إذا بدا أي شيء غير معتاد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hallo {name}! Nach {service}: Halten Sie den Bereich sauber, meiden Sie heute Hitze und direkte Sonne und schreiben Sie mir, falls Ihnen etwas ungewöhnlich vorkommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi {name}! After your {service}: keep the area clean, avoid heat and direct sun today, and message me if anything feels off."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hi {name}! After your {service}: keep the area clean, avoid heat and direct sun today, and message me if anything feels off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Después de {service}: mantén la zona limpia, evita el calor y el sol directo hoy, y escríbeme si notas algo raro."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Después de {service}: mantén la zona limpia, evita el calor y el sol directo hoy, y escríbeme si notas algo raro."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Después de {service}: mantén la zona limpia, evita el calor y el sol directo hoy, y escríbeme si notas algo raro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bonjour {name} ! Après {service} : gardez la zone propre, évitez la chaleur et le soleil direct aujourd'hui, et écrivez-moi si quelque chose vous semble inhabituel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नमस्ते {name}! {service} के बाद: उस जगह को साफ़ रखें, आज गर्मी और सीधी धूप से बचें, और कुछ भी ठीक न लगे तो मुझे संदेश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halo {name}! Setelah {service}: jaga area tetap bersih, hindari panas dan sinar matahari langsung hari ini, dan kabari saya jika ada yang terasa tidak biasa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ciao {name}! Dopo {service}: tieni la zona pulita, evita calore e sole diretto oggi e scrivimi se noti qualcosa di strano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oi, {name}! Cuidados depois de {service}: mantenha a região limpa, evite calor e sol direto hoje e me avise se algo parecer estranho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Olá, {name}! Cuidados depois de {service}: mantenha a zona limpa, evite calor e sol direto hoje e avise-me se algo lhe parecer estranho."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merhaba {name}! {service} sonrası: bölgeyi temiz tutun, bugün sıcaktan ve doğrudan güneşten kaçının; bir şey normal gelmezse bana yazın."
          }
        }
      }
    },
