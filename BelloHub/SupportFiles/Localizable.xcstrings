          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As alterações são salvas automaticamente. Os agendamentos já feitos mantêm as regras com que foram feitos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
