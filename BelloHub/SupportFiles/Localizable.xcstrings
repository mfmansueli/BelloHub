    "consent.subtitle" : {
      "comment" : "Subtitle of the consent sheet (D55).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لمتابعتك الخاصة. تبقى الورقة الموقَّعة لديك؛ وما تدوّنينه هنا لا يغادر هذا الـ iPhone أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für Ihre eigene Übersicht. Das unterschriebene Papier bleibt bei Ihnen; was Sie hier vermerken, verlässt dieses iPhone nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For your own control. The signed paper stays with you; what you note here never leaves this iPhone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "For your own control. The signed paper stays with you; what you note here never leaves this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para tu control. El papel firmado se queda contigo; lo que anotes aquí nunca sale de este iPhone."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para tu control. El papel firmado se queda contigo; lo que anotes aquí nunca sale de este iPhone."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para tu control. El papel firmado se queda contigo; lo que anotes aquí nunca sale de este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour votre suivi. Le papier signé reste chez vous ; ce que vous notez ici ne quitte jamais cet iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके अपने नियंत्रण के लिए। हस्ताक्षरित कागज़ आपके पास रहता है; यहाँ नोट की गई बात इस iPhone से कभी बाहर नहीं जाती।"
