    "onb.permissions.microphone.text" : {
      "comment" : "Permission page: microphone explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستمع Bello Hub فقط أثناء تسجيلك لخدمة، ثم ينظّم ما قلته. تراجع كل شيء قبل أن يُحفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub hört nur zu, während Sie eine Behandlung aufnehmen, und ordnet dann, was Sie gesagt haben. Sie prüfen alles, bevor es gespeichert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bello Hub listens only while you record a treatment, then organizes what you said. You review everything before it is saved."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub listens only while you record a treatment, then organizes what you said. You review everything before it is saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub solo escucha mientras grabas un tratamiento y luego organiza lo que dijiste. Lo revisas todo antes de guardarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub solo escucha mientras grabas un tratamiento y luego organiza lo que dijiste. Revisas todo antes de guardarlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub solo escucha mientras grabas un tratamiento y luego organiza lo que dijiste. Revisas todo antes de guardarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub n'écoute que pendant l'enregistrement d'un soin, puis organise ce que vous avez dit. Vous relisez tout avant l'enregistrement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub केवल तब सुनता है जब आप कोई उपचार रिकॉर्ड करते हैं, फिर आपकी बात को व्यवस्थित करता है। सेव होने से पहले आप सब कुछ देखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub hanya mendengarkan saat Anda merekam perawatan, lalu mengatur apa yang Anda katakan. Anda meninjau semuanya sebelum disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub ascolta solo mentre registri un trattamento, poi organizza ciò che hai detto. Rivedi tutto prima di salvare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Bello Hub só escuta enquanto você grava um atendimento e depois organiza o que você disse. Você revisa tudo antes de salvar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Bello Hub só ouve enquanto grava um atendimento e depois organiza o que disse. Revê tudo antes de guardar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub yalnızca bir işlemi kaydederken dinler, sonra söylediklerinizi düzenler. Kaydedilmeden önce her şeyi siz gözden geçirirsiniz."
          }
        }
      }
    },
    "onb.permissions.microphone.title" : {
      "comment" : "Permission page: microphone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
