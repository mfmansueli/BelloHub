    "fieldEditor.delete.message" : {
      "comment" : "Confirmation message before deleting a field of her own. Saved records keep what they hold; switching the field off is the way to pause it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لن يُسأل عن هذا الحقل بعد الآن. تحتفظ السجلات المحفوظة سابقًا بما كتبته. لإيقافه مؤقتًا، أوقفه بدلًا من حذفه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es wird nicht mehr abgefragt. Bereits gespeicherte Einträge behalten, was Sie geschrieben haben. Zum Pausieren schalten Sie es stattdessen aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will no longer be asked. Records you already saved keep what you wrote. To pause it instead, switch it off."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "It will no longer be asked. Records you already saved keep what you wrote. To pause it instead, switch it off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dejará de pedirse. Los registros que ya has guardado conservan lo que escribiste. Para pausarlo, desactívalo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dejará de pedirse. Los registros que ya guardaste conservan lo que escribiste. Para pausarlo, desactívalo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dejará de pedirse. Los registros que ya guardaste conservan lo que escribiste. Para pausarlo, desactívalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il ne sera plus demandé. Les fiches déjà enregistrées gardent ce que vous avez écrit. Pour le mettre en pause, désactivez-le."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह अब नहीं पूछा जाएगा। पहले से सहेजे गए रिकॉर्ड में आपका लिखा हुआ बना रहेगा। रोकने के लिए इसे बंद कर दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kolom ini tidak akan ditanyakan lagi. Catatan yang sudah Anda simpan tetap berisi tulisan Anda. Untuk menjedanya, matikan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non verrà più chiesto. I registri già salvati conservano ciò che hai scritto. Per metterlo in pausa, disattivalo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ele deixará de ser perguntado. Os registros que você já salvou mantêm o que você escreveu. Para apenas pausar, desative o campo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deixará de ser pedido. Os registos que já guardou mantêm o que escreveu. Para apenas o pausar, desative-o."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Artık sorulmayacak. Daha önce kaydettiğiniz kayıtlar yazdıklarınızı korur. Duraklatmak için bunun yerine kapatın."
          }
        }
      }
    },
