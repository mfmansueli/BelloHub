        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कुछ भी मिटाया नहीं गया। ऐप बंद करके फिर खोलें। अगर ऐसा होता रहे तो iPhone रीस्टार्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tidak ada yang terhapus. Tutup aplikasi lalu buka lagi. Jika terus terjadi, nyalakan ulang iPhone Anda."
          }
        },
        "it" : {
          "stringUnit" : {
