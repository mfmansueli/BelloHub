        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हम आपके प्रमाणपत्र नहीं पढ़ सके। जाँचें कि आपका iPhone अनलॉक है, फिर दोबारा कोशिश करें।"
