    "bookingSettings.pauseSheet.message" : {
      "comment" : "Sheet text: what a pause does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سيرى العملاء أنك لا تستقبل حجوزات ويمكنهم مراسلتك. تبقى المواعيد المحجوزة مسبقًا كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ihre Kundschaft sieht, dass Sie keine Buchungen annehmen, und kann Ihnen schreiben. Bereits gebuchte Termine bleiben, wie sie sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clients will see that you are not taking bookings and can write to you. Visits already booked stay as they are."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Clients will see that you are not taking bookings and can write to you. Visits already booked stay as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los clientes verán que no estás aceptando reservas y podrán escribirte. Las citas ya reservadas se quedan como están."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los clientes verán que no estás aceptando reservas y podrán escribirte. Las citas ya reservadas se quedan como están."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los clientes verán que no estás aceptando reservas y podrán escribirte. Las citas ya reservadas se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vos clients verront que vous n'acceptez pas de réservations et pourront vous écrire. Les rendez-vous déjà réservés restent tels quels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्लाइंट देखेंगे कि आप बुकिंग नहीं ले रहे हैं और आपको लिख सकेंगे। पहले से बुक किए गए अपॉइंटमेंट जैसे हैं वैसे ही रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klien akan melihat bahwa Anda tidak menerima pemesanan dan dapat menulis kepada Anda. Janji temu yang sudah dipesan tetap seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I clienti vedranno che non accetti prenotazioni e potranno scriverti. Gli appuntamenti già prenotati restano come sono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os clientes verão que você não está recebendo agendamentos e poderão escrever para você. Os agendamentos já feitos continuam como estão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os clientes verão que não está a receber marcações e poderão escrever-lhe. As marcações já feitas ficam como estão."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Müşteriler randevu kabul etmediğinizi görür ve size yazabilir. Önceden alınmış randevular olduğu gibi kalır."
          }
        }
      }
    },
