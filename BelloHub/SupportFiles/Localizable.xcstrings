    "noShowPolicy.off.note" : {
      "comment" : "Note while protection is off.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الحماية معطّلة. يمكن لأي شخص الحجز عبر الإنترنت. تبقى المواعيد الفائتة مسجّلة في ملف كل عميل، فيمكنك تفعيلها لاحقًا ورؤية ما مضى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Schutz ist aus. Alle können online buchen. Nicht wahrgenommene Termine werden weiterhin im Profil jeder Person festgehalten, sodass Sie ihn später einschalten und die Vergangenheit sehen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protection is off. Everyone can book online. Missed appointments are still written on each client's profile, so you can turn this on later and see the past."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Protection is off. Everyone can book online. Missed appointments are still written on each client's profile, so you can turn this on later and see the past."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La protección está desactivada. Cualquiera puede reservar en línea. Las citas no atendidas se siguen anotando en el perfil de cada cliente, así que puedes activarla más tarde y ver el historial."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La protección está desactivada. Cualquiera puede reservar en línea. Las inasistencias se siguen registrando en el perfil de cada cliente, así que puedes activarla después y ver el historial."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La protección está desactivada. Cualquiera puede reservar en línea. Las inasistencias se siguen registrando en el perfil de cada cliente, así que puedes activarla después y ver el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La protection est désactivée. Tout le monde peut réserver en ligne. Les rendez-vous manqués restent notés sur le profil de chaque client, vous pouvez donc l'activer plus tard et consulter l'historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सुरक्षा बंद है। कोई भी ऑनलाइन बुकिंग कर सकता है। छूटे हुए अपॉइंटमेंट फिर भी हर क्लाइंट की प्रोफ़ाइल में दर्ज होते रहते हैं, इसलिए आप इसे बाद में चालू करके पिछला रिकॉर्ड देख सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perlindungan mati. Siapa pun dapat memesan online. Janji temu yang terlewat tetap dicatat di profil setiap klien, jadi Anda dapat mengaktifkannya nanti dan melihat riwayatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La protezione è disattivata. Chiunque può prenotare online. Le mancate presentazioni vengono comunque annotate nel profilo di ogni cliente, così puoi attivarla più tardi e vedere lo storico."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A proteção está desativada. Qualquer pessoa pode agendar online. As faltas continuam registradas no perfil de cada cliente, então você pode ativar depois e ver o histórico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A proteção está desativada. Qualquer pessoa pode marcar online. As faltas continuam registadas no perfil de cada cliente, por isso pode ativá-la mais tarde e ver o histórico."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koruma kapalı. Herkes çevrimiçi randevu alabilir. Gelinmeyen randevular yine de her müşterinin profiline yazılır; böylece korumayı sonra açıp geçmişi görebilirsiniz."
          }
        }
      }
    },
    "noShowPolicy.period.footer" : {
      "comment" : "Explains the counting period.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتوقف حالات عدم الحضور القديمة عن الاحتساب تلقائيًا، فلا يلاحق يومٌ سيئ أحدًا إلى الأبد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ältere Fälle zählen automatisch nicht mehr mit, sodass ein schlechter Tag niemanden ewig begleitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Older no-shows stop counting by themselves, so one bad day never follows a client forever."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Older no-shows stop counting by themselves, so one bad day never follows a client forever."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las citas no atendidas más antiguas dejan de contar solas, así que un mal día nunca persigue a nadie para siempre."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las inasistencias más antiguas dejan de contar solas, así que un mal día nunca persigue a nadie para siempre."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las inasistencias más antiguas dejan de contar solas, así que un mal día nunca persigue a nadie para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rendez-vous manqués plus anciens cessent de compter d'eux-mêmes, si bien qu'un mauvais jour ne suit jamais personne pour toujours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पुराने ‘नहीं आए’ अपने आप गिने जाना बंद हो जाते हैं, इसलिए एक बुरा दिन किसी के साथ हमेशा नहीं चलता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catatan tidak datang yang lama berhenti dihitung dengan sendirinya, jadi satu hari buruk tidak membayangi klien selamanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le mancate presentazioni più vecchie smettono di contare da sole, così un giorno storto non segue nessuno per sempre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As faltas mais antigas deixam de contar sozinhas, então um dia ruim nunca acompanha alguém para sempre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As faltas mais antigas deixam de contar por si, para que um mau dia nunca acompanhe alguém para sempre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eski gelmemeler kendiliğinden sayılmaz olur; böylece bir kötü gün kimsenin peşini sonsuza dek bırakmaz."
          }
        }
      }
    },
