    "onb.permissions.notifications.text" : {
      "comment" : "Permission page: notifications explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حجوزات جديدة وإلغاءات ورسائل العملاء. تبقى الأسماء مخفية على شاشة القفل إن أردت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neue Buchungen, Absagen und Rückmeldungen Ihrer Kundschaft. Namen bleiben auf dem Sperrbildschirm auf Wunsch verborgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New bookings, cancellations and client check-ins. Names stay hidden on your lock screen if you prefer."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "New bookings, cancellations and client check-ins. Names stay hidden on your lock screen if you prefer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nuevas reservas, cancelaciones y avisos de tus clientes. Los nombres se ocultan en la pantalla de bloqueo si lo prefieres."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nuevas reservas, cancelaciones y avisos de tus clientes. Los nombres se ocultan en la pantalla de bloqueo si lo prefieres."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nuevas reservas, cancelaciones y avisos de tus clientes. Los nombres se ocultan en la pantalla de bloqueo si lo prefieres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nouvelles réservations, annulations et messages de vos clients. Les noms restent masqués sur l'écran verrouillé si vous le souhaitez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नई बुकिंग, रद्द करना और क्लाइंट के संदेश। चाहें तो नाम लॉक स्क्रीन पर छिपे रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pemesanan baru, pembatalan, dan check-in klien. Nama tetap tersembunyi di layar kunci jika Anda mau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nuove prenotazioni, cancellazioni e check-in dei clienti. I nomi restano nascosti nella schermata di blocco, se preferisci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Novos agendamentos, cancelamentos e check-ins de clientes. Os nomes ficam ocultos na tela de bloqueio, se você preferir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Novas marcações, cancelamentos e check-ins de clientes. Os nomes ficam ocultos no ecrã de bloqueio, se preferir."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yeni randevular, iptaller ve müşteri bildirimleri. İsterseniz isimler kilit ekranında gizli kalır."
          }
        }
      }
    },
    "onb.permissions.notifications.title" : {
      "comment" : "Permission page: notifications.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اعرف متى يحتاجك شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erfahren Sie, wenn etwas Ihre Aufmerksamkeit braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Know when something needs you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Know when something needs you."
          }
