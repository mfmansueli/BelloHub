    "onb.permissions.camera.text" : {
      "comment" : "Permission page: camera explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التقط صور قبل وبعد داخل Bello Hub. لا تُحفظ أبدًا في معرض صور هاتفك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Machen Sie Vorher-nachher-Fotos direkt in Bello Hub. Sie werden nie in Ihrer Fotomediathek gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take before and after photos inside Bello Hub. They are never saved to your camera roll."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Take before and after photos inside Bello Hub. They are never saved to your camera roll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haz fotos de antes y después dentro de Bello Hub. Nunca se guardan en tu carrete."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haz fotos de antes y después dentro de Bello Hub. Nunca se guardan en tu carrete."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
