          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prenez des photos avant et après dans Bello Hub. Elles ne sont jamais enregistrées dans votre pellicule."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub के अंदर पहले और बाद की तस्वीरें लें। वे आपके कैमरा रोल में कभी सेव नहीं होतीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ambil foto sebelum dan sesudah di dalam Bello Hub. Foto tidak pernah disimpan ke galeri ponsel Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scatta foto prima e dopo all'interno di Bello Hub. Non vengono mai salvate nel rullino."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tire fotos de antes e depois dentro do Bello Hub. Elas nunca são salvas no rolo da câmera."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tire fotografias de antes e depois dentro do Bello Hub. Nunca são guardadas na galeria."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
