          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्लाइंट अपॉइंटमेंट से इतने समय पहले तक खुद रद्द कर सकते हैं या समय बदल सकते हैं।"
