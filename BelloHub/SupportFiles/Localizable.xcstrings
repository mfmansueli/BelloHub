    "treatmentFlow.photos.private" : {
      "comment" : "Photos: footer reassurance",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خاصة افتراضيًا. تبقى الصور مرتبطة بالعميلة والتاريخ وهذه الزيارة، ولا تُستخدم أبدًا في التسويق ما لم تختاري ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Standardmäßig privat. Fotos bleiben mit der Kundin, dem Datum und diesem Besuch verknüpft und werden nie für Werbung genutzt, es sei denn, du entscheidest es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private by default. Photos stay linked to the client, the date and this visit, and are never used as marketing unless you choose."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Private by default. Photos stay linked to the client, the date and this visit, and are never used as marketing unless you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Privadas por defecto. Las fotos quedan ligadas a la clienta, la fecha y esta visita, y nunca se usan como publicidad salvo que tú lo decidas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Privadas por defecto. Las fotos quedan ligadas a la clienta, la fecha y esta visita, y nunca se usan como publicidad a menos que lo decidas."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Privadas por defecto. Las fotos quedan ligadas a la clienta, la fecha y esta visita, y nunca se usan como publicidad a menos que lo decidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Privées par défaut. Les photos restent liées à la cliente, à la date et à cette visite, et ne servent jamais au marketing sauf si vous le décidez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "डिफ़ॉल्ट रूप से निजी। फ़ोटो क्लाइंट, तारीख़ और इस विज़िट से जुड़ी रहती हैं, और आपके चुने बिना कभी मार्केटिंग में इस्तेमाल नहीं होतीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pribadi secara bawaan. Foto tetap terkait dengan klien, tanggal, dan kunjungan ini, dan tidak pernah dipakai untuk pemasaran kecuali kamu memilihnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Private per impostazione predefinita. Le foto restano legate alla cliente, alla data e a questa visita e non diventano mai materiale promozionale se non lo decidi tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Privadas por padrão. As fotos ficam ligadas à cliente, à data e a esta visita, e nunca viram divulgação a menos que você escolha."
