    "cancelPolicy.footer" : {
      "comment" : "Footnote: changes save by themselves; existing bookings keep their rules.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحفظ التغييرات تلقائيًا. تحتفظ الحجوزات التي تمت بالفعل بالقواعد التي أُجريت بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Änderungen werden automatisch gespeichert. Bereits getätigte Buchungen behalten die Regeln, unter denen sie erstellt wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes save automatically. Bookings already made keep the rules they were made under."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Changes save automatically. Bookings already made keep the rules they were made under."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los cambios se guardan automáticamente. Las reservas ya hechas conservan las reglas con las que se hicieron."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los cambios se guardan automáticamente. Las reservas ya hechas conservan las reglas con las que se hicieron."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los cambios se guardan automáticamente. Las reservas ya hechas conservan las reglas con las que se hicieron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les modifications s'enregistrent automatiquement. Les réservations déjà faites gardent les règles en vigueur à leur création."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बदलाव अपने आप सेव हो जाते हैं। पहले से की गई बुकिंग उन्हीं नियमों पर रहती हैं जिनके साथ वे की गई थीं।"
