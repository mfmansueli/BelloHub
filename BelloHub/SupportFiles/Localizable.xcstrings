    "onb.terminology.note" : {
      "comment" : "Explains why names matter. The voice notes run on the phone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتعلّم Bello Hub الأسماء التي تستخدمها لخدماتك وبروتوكولاتك، لتبدو الملاحظات الصوتية والسجلات كأنها منك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub lernt die Namen, die Sie für Ihre Leistungen und Protokolle verwenden, damit Sprachnotizen und Akten nach Ihnen klingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bello Hub learns the names you use for your services and protocols, so voice notes and records sound like you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub learns the names you use for your services and protocols, so voice notes and records sound like you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub aprende los nombres que usas para tus servicios y protocolos, para que las notas de voz y las fichas suenen como tú."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub aprende los nombres que usas para tus servicios y protocolos, para que las notas de voz y las fichas suenen como tú."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub aprende los nombres que usas para tus servicios y protocolos, para que las notas de voz y las fichas suenen como tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub apprend les noms que vous utilisez pour vos prestations et protocoles, afin que les notes vocales et les fiches vous ressemblent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub आपकी सेवाओं और प्रोटोकॉल के नाम सीखता है, ताकि वॉइस नोट और रिकॉर्ड आपकी तरह लगें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub mempelajari nama yang Anda pakai untuk layanan dan protokol, sehingga catatan suara dan rekaman terdengar seperti Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub impara i nomi che usi per i tuoi servizi e protocolli, così note vocali e schede suonano come te."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Bello Hub aprende os nomes que você usa para seus serviços e protocolos, para que as notas de voz e os registros soem como você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Bello Hub aprende os nomes que utiliza para os seus serviços e protocolos, para que as notas de voz e os registos soem como você."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello Hub, hizmetleriniz ve protokolleriniz için kullandığınız adları öğrenir; böylece sesli notlar ve kayıtlar size benzer."
          }
        }
      }
    },
    "onb.terminology.subtitle" : {
      "comment" : "Setup step: terminology subtitle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سمِّ خدماتك وبروتوكولاتك كما تنطقها. ستظهر هكذا تمامًا في كل مكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Benennen Sie Ihre Leistungen und Protokolle so, wie Sie sie sagen. Überall erscheinen sie genau so."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name your services and protocols the way you say them. They show up exactly like this everywhere."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Name your services and protocols the way you say them. They show up exactly like this everywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nombra tus servicios y protocolos como los dices. Aparecen exactamente así en todas partes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nombra tus servicios y protocolos como los dices. Aparecen exactamente así en todas partes."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nombra tus servicios y protocolos como los dices. Aparecen exactamente así en todas partes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nommez vos prestations et vos protocoles comme vous les dites. Ils apparaissent tels quels partout."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपनी सेवाओं और प्रोटोकॉल के नाम वैसे ही रखें जैसे आप बोलते हैं। वे हर जगह बिल्कुल ऐसे ही दिखेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beri nama layanan dan protokol Anda sesuai cara Anda menyebutnya. Namanya tampil persis begitu di mana-mana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dai ai tuoi servizi e protocolli i nomi che usi. Compaiono così ovunque."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dê nome aos seus serviços e protocolos do jeito que você fala. Eles aparecem assim em todo lugar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dê nome aos seus serviços e protocolos como os diz. Aparecem assim em todo o lado."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hizmetlerinizi ve protokollerinizi söylediğiniz gibi adlandırın. Her yerde tam olarak böyle görünürler."
          }
        }
      }
    },
    "onb.terminology.term" : {
