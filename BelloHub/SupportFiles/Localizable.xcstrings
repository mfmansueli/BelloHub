    "noShowCount.reached.approve" : {
      "comment" : "Count card at the limit, action 'approve new bookings'. %@ is the client's first name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بلغ %@ حدّك. من الآن فصاعدًا تحتاج حجوزاته عبر الإنترنت إلى موافقتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hat Ihr Limit erreicht. Ab jetzt brauchen die Online-Buchungen Ihre Bestätigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reached your limit. From now on the online bookings need your approval."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ reached your limit. From now on the online bookings need your approval."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ha llegado a tu límite. A partir de ahora, sus reservas en línea necesitan tu aprobación."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ llegó a tu límite. A partir de ahora, sus reservas en línea necesitan tu aprobación."
