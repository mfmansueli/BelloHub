    "addOns.delete.message" : {
      "comment" : "Message of the delete-add-on dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لن يتمكن العملاء من إضافتها بعد الآن. لا تتغير الزيارات السابقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Kundschaft kann es nicht mehr dazubuchen. Vergangene Termine bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clients will no longer be able to add it. Past visits are not changed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Clients will no longer be able to add it. Past visits are not changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los clientes ya no podrán añadirlo. Las citas pasadas no cambian."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los clientes ya no podrán agregarlo. Las citas pasadas no cambian."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los clientes ya no podrán agregarlo. Las citas pasadas no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les clients ne pourront plus l'ajouter. Les rendez-vous passés ne changent pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्लाइंट इसे अब नहीं जोड़ सकेंगे। पिछली विज़िट नहीं बदलतीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klien tidak bisa lagi menambahkannya. Kunjungan yang sudah lewat tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I clienti non potranno più aggiungerlo. Le visite passate non cambiano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os clientes não poderão mais adicioná-lo. Atendimentos passados não mudam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os clientes deixam de o poder adicionar. As visitas passadas não mudam."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Müşteriler artık bunu ekleyemez. Geçmiş randevular değişmez."
          }
        }
      }
    },
