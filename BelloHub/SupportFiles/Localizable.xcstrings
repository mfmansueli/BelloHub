    "recordTemplate.subtitle" : {
      "comment" : "Record fields screen: line under the title. %@ is what she calls the people she serves, singular (\"client\"). The German sentence uses pro %@, which works with every term.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
