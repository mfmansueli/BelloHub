    "treatmentFlow.register.example.text" : {
      "comment" : "Register: example of what to say",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«برازيليان غلو. خفّفت الشدة على الخدين. سيروم مهدّئ. استجابت جيدًا.»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Brazilian Glow. Intensität an den Wangen reduziert. Beruhigendes Serum. Sie hat gut reagiert.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Brazilian Glow. Reduced intensity on the cheeks. Calming serum. She responded well.”"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Brazilian Glow. Reduced intensity on the cheeks. Calming serum. She responded well.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Brazilian Glow. Reduje la intensidad en las mejillas. Sérum calmante. Respondió bien.”"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Brazilian Glow. Reduje la intensidad en las mejillas. Sérum calmante. Respondió bien.”"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Brazilian Glow. Reduje la intensidad en las mejillas. Sérum calmante. Respondió bien.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« Brazilian Glow. Intensité réduite sur les joues. Sérum apaisant. Elle a bien réagi. »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“ब्राज़ीलियन ग्लो। गालों पर तीव्रता कम की। शांत करने वाला सीरम। उन्होंने अच्छी प्रतिक्रिया दी।”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Brazilian Glow. Intensitas di pipi dikurangi. Serum penenang. Responsnya baik.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Brazilian Glow. Ho ridotto l’intensità sulle guance. Siero calmante. Ha risposto bene.”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Brazilian Glow. Reduzi a intensidade nas bochechas. Sérum calmante. Respondeu bem.”"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Brazilian Glow. Reduzi a intensidade nas bochechas. Sérum calmante. Respondeu bem.”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Brazilian Glow. Yanaklarda yoğunluğu azalttım. Yatıştırıcı serum. İyi tepki verdi.”"
          }
        }
      }
    },
