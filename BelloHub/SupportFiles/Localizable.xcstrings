    "appointment.message.cancelled" : {
      "comment" : "Message to a client when the professional cancels. Keep {name}, {service}, {date} and {time}. Never any clinical data.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مرحبًا {name}! أعتذر، اضطررت إلى إلغاء موعدك ({service}) يوم {date} الساعة {time}. أخبرني بالوقت الجديد الذي يناسبك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hallo {name}! Es tut mir leid, ich muss Ihren Termin ({service}) am {date} um {time} absagen. Sagen Sie mir bitte, welcher neue Termin Ihnen passt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi {name}, I am sorry, I need to cancel your {service} on {date} at {time}. Let me know which new time suits you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hi {name}, I am sorry, I need to cancel your {service} on {date} at {time}. Let me know which new time suits you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Lo siento, tengo que cancelar tu {service} del {date} a las {time}. Dime qué nuevo horario te viene bien."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Lo siento, tengo que cancelar tu {service} del {date} a las {time}. Dime qué nuevo horario te funciona."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Lo siento, tengo que cancelar tu {service} del {date} a las {time}. Dime qué nuevo horario te funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bonjour {name} ! Toutes mes excuses, je dois annuler votre {service} du {date} à {time}. Dites-moi quel nouvel horaire vous convient."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नमस्ते {name}! माफ़ कीजिए, मुझे {date} को {time} बजे की आपकी {service} रद्द करनी पड़ रही है। कृपया बताइए कि आपके लिए कौन सा नया समय ठीक रहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halo {name}! Maaf, saya harus membatalkan {service} Anda pada {date} pukul {time}. Kabari saya waktu baru yang cocok untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ciao {name}! Mi dispiace, devo annullare il tuo {service} di {date} alle {time}. Dimmi quale nuovo orario ti va bene."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oi, {name}! Sinto muito, preciso cancelar o seu {service} de {date} às {time}. Me diga qual novo horário fica bom para você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Olá, {name}! Peço desculpa, tenho de cancelar o seu {service} de {date} às {time}. Diga-me que novo horário lhe convém."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merhaba {name}! Üzgünüm, {date} günü {time} saatindeki {service} randevunuzu iptal etmem gerekiyor. Size hangi yeni saatin uygun olduğunu söyler misiniz?"
          }
        }
      }
    },
    "appointment.message.noShow" : {
      "comment" : "Friendly note to a client who did not come. Keep {name}. Never a reproach.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مرحبًا {name}! افتقدناك اليوم. إذا تعذّر عليك الحضور، فرسالة قصيرة تساعدني على إتاحة وقتك لشخص آخر. إلى اللقاء قريبًا!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hallo {name}! Wir haben Sie heute vermisst. Wenn Sie nicht kommen können, hilft mir eine kurze Nachricht, Ihren Termin an jemand anderen zu vergeben. Bis bald!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi {name}, we missed you today. If you can't make it, a quick message helps me offer your time to someone else. See you soon!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hi {name}, we missed you today. If you can't make it, a quick message helps me offer your time to someone else. See you soon!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Te hemos echado de menos hoy. Si no puedes venir, un mensaje rápido me ayuda a ofrecer tu hora a otra persona. ¡Hasta pronto!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Te extrañamos hoy. Si no puedes venir, un mensaje rápido me ayuda a ofrecer tu horario a otra persona. ¡Hasta pronto!"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Te extrañamos hoy. Si no puedes venir, un mensaje rápido me ayuda a ofrecer tu horario a otra persona. ¡Hasta pronto!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bonjour {name} ! Vous nous avez manqué aujourd'hui. Si vous ne pouvez pas venir, un petit message m'aide à proposer votre créneau à quelqu'un d'autre. À bientôt !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नमस्ते {name}! आज हमें आपकी कमी महसूस हुई। अगर आप नहीं आ पा रहे हैं, तो एक छोटा संदेश मुझे आपका समय किसी और को देने में मदद करता है। जल्द मिलते हैं!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halo {name}! Kami melewatkan Anda hari ini. Jika Anda tidak bisa datang, pesan singkat membantu saya menawarkan waktu Anda ke orang lain. Sampai jumpa!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ciao {name}! Oggi ti abbiamo aspettato. Se non puoi venire, un messaggio veloce mi aiuta a offrire il tuo orario a qualcun altro. A presto!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oi, {name}! Sentimos a sua falta hoje. Se não puder vir, um aviso rápido me ajuda a oferecer o horário para outra pessoa. Até breve!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Olá, {name}! Sentimos a sua falta hoje. Se não puder vir, um aviso rápido ajuda-me a oferecer o horário a outra pessoa. Até breve!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merhaba {name}! Bugün sizi özledik. Gelemeyecekseniz kısa bir mesaj, saatinizi başka birine ayırmama yardımcı olur. Görüşmek üzere!"
          }
        }
      }
    },
    "appointment.message.runningLate" : {
      "comment" : "Message to the clients waiting when the professional runs late. %@ is the delay such as '15 min'. Keep {name}.",
