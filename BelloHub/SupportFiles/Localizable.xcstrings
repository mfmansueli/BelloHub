    "import.sources.privacy" : {
      "comment" : "Footnote on the first import step about contacts privacy.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نقرأ فقط جهات الاتصال التي تختارها. لا يُحفظ شيء سوى ما تستورده."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es werden nur die Kontakte gelesen, die Sie auswählen. Gespeichert wird nur, was Sie importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the contacts you choose are read. Nothing is kept except what you import."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Only the contacts you choose are read. Nothing is kept except what you import."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo leemos los contactos que elijas. No se guarda nada salvo lo que importes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
