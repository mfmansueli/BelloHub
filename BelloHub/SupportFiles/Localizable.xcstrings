          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्लाइंट अपने साथ किसी दोस्त या रिश्तेदार को ला सकते हैं। अपॉइंटमेंट एक के बाद एक होते हैं और समय जुड़ता जाता है।"
