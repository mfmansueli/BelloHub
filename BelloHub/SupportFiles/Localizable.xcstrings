    "addOns.preview.message" : {
      "comment" : "Text of the card that shows the client's side of the add-ons.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "في خطوة الخدمة يحدّدون الإضافات التي يريدونها. تضيف صفحة الحجز الوقت وتعرض المجموع الجديد قبل اختيار اليوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Im Schritt der Leistung wählen sie die gewünschten Extras. Die Buchungsseite addiert die Zeit und zeigt die neue Summe, bevor sie einen Tag wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the service step they tick the extras they want. The booking page adds the time and shows the new total before they pick a day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "On the service step they tick the extras they want. The booking page adds the time and shows the new total before they pick a day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En el paso del servicio, marcan los extras que quieren. La página de reservas suma el tiempo y muestra el nuevo total antes de elegir el día."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En el paso del servicio, marcan los extras que quieren. La página de reservas suma el tiempo y muestra el nuevo total antes de elegir el día."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En el paso del servicio, marcan los extras que quieren. La página de reservas suma el tiempo y muestra el nuevo total antes de elegir el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "À l'étape de la prestation, ils cochent les suppléments voulus. La page de réservation ajoute le temps et affiche le nouveau total avant le choix du jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सेवा वाले चरण में वे अपनी पसंद की अतिरिक्त चीज़ें चुनते हैं। बुकिंग पेज समय जोड़ देता है और दिन चुनने से पहले नया कुल दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Di langkah layanan, mereka mencentang tambahan yang diinginkan. Halaman pemesanan menambah waktu dan menampilkan total baru sebelum mereka memilih hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nel passaggio del servizio, selezionano gli extra che vogliono. La pagina di prenotazione somma il tempo e mostra il nuovo totale prima di scegliere il giorno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na etapa do serviço, eles marcam os extras que querem. A página de agendamento soma o tempo e mostra o novo total antes de escolherem o dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No passo do serviço, marcam os extras que querem. A página de marcações soma o tempo e mostra o novo total antes de escolherem o dia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hizmet adımında istedikleri ekstraları işaretlerler. Randevu sayfası süreyi ekler ve gün seçmeden önce yeni toplamı gösterir."
          }
        }
      }
    },
