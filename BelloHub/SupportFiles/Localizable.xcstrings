            "state" : "needs_review",
            "value" : "After that you can still cancel here, and {professional} is told right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pasado ese plazo aún puedes cancelar aquí, y {professional} recibe un aviso de inmediato."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Después de ese plazo aún puedes cancelar aquí, y {professional} recibe un aviso al instante."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Después de ese plazo aún puedes cancelar aquí, y {professional} recibe un aviso al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Passé ce délai, vous pouvez encore annuler ici, et {professional} reçoit aussitôt un avis."
