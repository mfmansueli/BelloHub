    "team.footer" : {
      "comment" : "Footnote of the Team screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أنت المالكة وترين كل شيء دائمًا. لكل متخصصة تقويمها وأوقات حجزها الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie sind die Inhaberin und sehen immer alles. Jede Fachkraft hat einen eigenen Kalender und eigene Buchungszeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are the owner and always see everything. Each professional has their own calendar and booking times."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "You are the owner and always see everything. Each professional has their own calendar and booking times."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eres la dueña y siempre lo ves todo. Cada profesional tiene su propio calendario y sus propios horarios de reserva."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eres la dueña y siempre ves todo. Cada profesional tiene su propio calendario y sus propios horarios de reserva."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eres la dueña y siempre ves todo. Cada profesional tiene su propio calendario y sus propios horarios de reserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous êtes la propriétaire et voyez toujours tout. Chaque professionnel a son propre calendrier et ses propres horaires de réservation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आप मालिक हैं और हमेशा सब कुछ देखती हैं। हर प्रोफ़ेशनल का अपना कैलेंडर और बुकिंग समय होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anda pemiliknya dan selalu melihat semuanya. Setiap profesional punya kalender dan jam pemesanan sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sei la titolare e vedi sempre tutto. Ogni professionista ha il proprio calendario e i propri orari di prenotazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você é a dona e sempre vê tudo. Cada profissional tem a própria agenda e os próprios horários de agendamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "É a dona e vê sempre tudo. Cada profissional tem a sua própria agenda e os seus próprios horários de marcação."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sahibi sizsiniz ve her şeyi her zaman görürsünüz. Her profesyonelin kendi takvimi ve randevu saatleri vardır."
          }
        }
      }
    },
