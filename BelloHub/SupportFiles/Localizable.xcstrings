    "quickReplies.default.comeBack.text" : {
      "comment" : "Built-in reply: invites a client who has not been for a while. Keep {name} {service} {link}.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مرحبًا {name}! مضى وقت منذ موعد {service} الأخير. لدي بعض المواعيد المتاحة هذا الشهر. هل أحجز لك موعدًا؟ {link}"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hallo {name}! Ihr letzter Termin für {service} ist schon eine Weile her. Ich habe diesen Monat noch ein paar freie Termine. Soll ich Ihnen einen reservieren? {link}"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi {name}! It has been a while since your {service}. I have a few openings this month. Want me to save a time? {link}"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hi {name}! It has been a while since your {service}. I have a few openings this month. Want me to save a time? {link}"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Ha pasado un tiempo desde tu última cita de {service}. Tengo algunos huecos libres este mes. ¿Quieres que te reserve uno? {link}"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Ha pasado un tiempo desde tu última cita de {service}. Tengo algunos horarios libres este mes. ¿Quieres que te aparte uno? {link}"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Ha pasado un tiempo desde tu última cita de {service}. Tengo algunos horarios libres este mes. ¿Quieres que te aparte uno? {link}"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bonjour {name} ! Cela fait un moment depuis votre dernier rendez-vous pour {service}. J'ai quelques créneaux libres ce mois-ci. Souhaitez-vous que je vous en réserve un ? {link}"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नमस्ते {name}! आपके पिछले {service} अपॉइंटमेंट को काफ़ी समय हो गया है। इस महीने मेरे पास कुछ समय खाली हैं। क्या मैं आपके लिए एक समय रोक दूँ? {link}"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halo {name}! Sudah cukup lama sejak janji temu {service} terakhir Anda. Bulan ini saya punya beberapa slot kosong. Mau saya simpankan satu waktu? {link}"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ciao {name}! È passato un po' dall'ultimo appuntamento per {service}. Ho qualche posto libero questo mese. Vuoi che ti tenga da parte un orario? {link}"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oi, {name}! Já faz um tempo desde seu último atendimento de {service}. Tenho alguns horários livres neste mês. Quer que eu reserve um para você? {link}"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Olá, {name}! Já passou algum tempo desde a sua última sessão de {service}. Tenho algumas vagas este mês. Quer que lhe guarde uma hora? {link}"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merhaba {name}! {service} randevunuzun üzerinden epey zaman geçti. Bu ay birkaç boş saatim var. Sizin için bir saat ayırmamı ister misiniz? {link}"
