    "credentials.error.load" : {
      "comment" : "Shown when the credentials cannot be read.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذّرت قراءة شهاداتك. تأكد من أن iPhone غير مقفل ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wir konnten Ihre Zertifikate nicht lesen. Prüfen Sie, ob Ihr iPhone entsperrt ist, und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We could not read your credentials. Check that your iPhone is unlocked and try again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "We could not read your credentials. Check that your iPhone is unlocked and try again."
