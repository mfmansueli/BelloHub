    "recordTemplate.offNote" : {
      "comment" : "Record fields: footnote. Switching a field off never removes what saved treatment records hold.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إيقاف حقل يعني فقط التوقف عن سؤاله. ما حفظته سابقًا يبقى كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein ausgeschaltetes Feld wird nur nicht mehr abgefragt. Was Sie bereits gespeichert haben, bleibt erhalten."
          }
        },
        "en" : {
