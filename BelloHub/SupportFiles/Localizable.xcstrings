    "onb.permissions.camera.text" : {
      "comment" : "Permission page: camera explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التقط صور قبل وبعد داخل Bello Hub. لا تُحفظ أبدًا في معرض صور هاتفك."
