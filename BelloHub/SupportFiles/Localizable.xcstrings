    "noShowPolicy.footer" : {
      "comment" : "Footnote about privacy of the counts.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحفظ التغييرات تلقائيًا. تبقى الأعداد على iPhone وفي iCloud الخاص بك. يُحتسب عملاؤك أنت فقط: لا يُشارك شيء مع مختصين آخرين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Änderungen werden automatisch gespeichert. Die Zähler bleiben auf Ihrem iPhone und in Ihrer iCloud. Es wird nur Ihre eigene Kundschaft gezählt: Nichts wird mit anderen Fachkräften geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes save automatically. Counts stay on your iPhone and in your iCloud. Only your own clients are counted: nothing is shared with other professionals."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Changes save automatically. Counts stay on your iPhone and in your iCloud. Only your own clients are counted: nothing is shared with other professionals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los cambios se guardan automáticamente. Los conteos se quedan en tu iPhone y en tu iCloud. Solo se cuentan tus propios clientes: nada se comparte con otros profesionales."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los cambios se guardan automáticamente. Los conteos se quedan en tu iPhone y en tu iCloud. Solo se cuentan tus propios clientes: nada se comparte con otros profesionales."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los cambios se guardan automáticamente. Los conteos se quedan en tu iPhone y en tu iCloud. Solo se cuentan tus propios clientes: nada se comparte con otros profesionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les modifications s'enregistrent automatiquement. Les comptages restent sur votre iPhone et dans votre iCloud. Seuls vos propres clients sont comptés : rien n'est partagé avec d'autres professionnels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बदलाव अपने आप सेव हो जाते हैं। गिनती आपके iPhone और आपके iCloud में ही रहती है। सिर्फ़ आपके अपने क्लाइंट गिने जाते हैं: दूसरे प्रोफ़ेशनल्स के साथ कुछ भी साझा नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perubahan tersimpan otomatis. Hitungan tetap di iPhone dan iCloud Anda. Hanya klien Anda sendiri yang dihitung: tidak ada yang dibagikan kepada profesional lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le modifiche vengono salvate automaticamente. I conteggi restano sul tuo iPhone e nel tuo iCloud. Vengono contati solo i tuoi clienti: nulla viene condiviso con altri professionisti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As alterações são salvas automaticamente. As contagens ficam no seu iPhone e no seu iCloud. Só os seus próprios clientes são contados: nada é compartilhado com outros profissionais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As alterações são guardadas automaticamente. As contagens ficam no seu iPhone e no seu iCloud. Só são contados os seus próprios clientes: nada é partilhado com outros profissionais."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Değişiklikler otomatik kaydedilir. Sayımlar iPhone'unuzda ve iCloud'unuzda kalır. Yalnızca kendi müşterileriniz sayılır: başka profesyonellerle hiçbir şey paylaşılmaz."
          }
        }
      }
    },
