    "healthForm.minor.hint" : {
      "comment" : "Hint under the minor switch (D17, D55).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اكتبي اسم القاصر. يجيب أحد الوالدين أو ولي الأمر نيابةً عنه؛ وتجمعين الموافقة شخصيًا."
