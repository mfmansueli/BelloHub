    "storage.unavailable.message" : {
      "comment" : "Shown when the vault could not be opened. Nothing is deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم يُحذف شيء. أغلق التطبيق وافتحه من جديد. إن تكرر ذلك فأعد تشغيل iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es wurde nichts gelöscht. Schließen Sie die App und öffnen Sie sie erneut. Falls es weiter auftritt, starten Sie das iPhone neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing was deleted. Close the app and open it again. If this keeps happening, restart your iPhone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nothing was deleted. Close the app and open it again. If this keeps happening, restart your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se ha borrado nada. Cierra la app y ábrela de nuevo. Si sigue ocurriendo, reinicia el iPhone."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
