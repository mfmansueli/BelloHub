        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नमस्ते! आपके संदेश के लिए धन्यवाद। आप %1$@ के साथ यहाँ बुक कर सकते हैं: %2$@"
