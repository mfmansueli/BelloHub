        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Untuk kontrol Anda sendiri. Kertas yang ditandatangani tetap pada Anda; apa yang Anda catat di sini tidak pernah keluar dari iPhone ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per il tuo controllo. Il foglio firmato resta a te; ciò che annoti qui non esce mai da questo iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para o seu controle. O papel assinado fica com você; o que anotar aqui nunca sai deste iPhone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
