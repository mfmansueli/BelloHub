    "clientEdit.archive.dialogMessage" : {
      "comment" : "Edit screen: message of the archive dialog. %@ is her first name; no pronoun for the client.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتم إزالة %@ من قوائمك ومن اقتراحات الحجز. يبقى السجل محفوظًا ويمكنك استعادته في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ verschwindet aus Ihren Listen und den Buchungsvorschlägen. Die Akte bleibt erhalten und Sie können sie jederzeit wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ disappears from your lists and from booking suggestions. The record is kept and you can restore it any time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ disappears from your lists and from booking suggestions. The record is kept and you can restore it any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ desaparece de tus listas y de las sugerencias de reserva. La ficha se conserva y puedes restaurarla cuando quieras."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ desaparece de tus listas y de las sugerencias de reserva. La ficha se conserva y puedes restaurarla cuando quieras."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ desaparece de tus listas y de las sugerencias de reserva. La ficha se conserva y puedes restaurarla cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ disparaît de vos listes et des suggestions de réservation. La fiche est conservée et vous pouvez la restaurer à tout moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपकी सूचियों और बुकिंग सुझावों से %@ हट जाएँगे। रिकॉर्ड सुरक्षित रहता है और आप इसे कभी भी वापस ला सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hilang dari daftar dan saran pemesanan Anda. Catatan tetap disimpan dan bisa dipulihkan kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ scompare dai tuoi elenchi e dai suggerimenti di prenotazione. La scheda viene conservata e puoi ripristinarla in qualsiasi momento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sai das suas listas e das sugestões de agendamento. A ficha é mantida e você pode restaurá-la quando quiser."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sai das suas listas e das sugestões de marcação. A ficha é mantida e pode restaurá-la quando quiser."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ listelerinizden ve randevu önerilerinden kalkar. Kayıt korunur ve istediğiniz zaman geri yükleyebilirsiniz."
          }
        }
      }
    },
