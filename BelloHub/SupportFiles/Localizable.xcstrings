    "treatmentFlow.lock.message" : {
      "comment" : "Notice under the save button: the 24-hour lock",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يمكنك تعديل هذا السجل خلال 24 ساعة. بعدها يُقفل، وتبقى أي تصحيحات ظاهرة في سجل التعديلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kannst diesen Eintrag 24 Stunden lang ändern. Danach wird er gesperrt, und jede Korrektur bleibt in einem Änderungsverlauf sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change this record for 24 hours. After that it locks, and any correction stays visible in an edit trail."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "You can change this record for 24 hours. After that it locks, and any correction stays visible in an edit trail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes cambiar este registro durante 24 horas. Después se bloquea y cualquier corrección queda visible en un historial de ediciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes cambiar este registro durante 24 horas. Después se bloquea y cualquier corrección queda visible en un historial de ediciones."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes cambiar este registro durante 24 horas. Después se bloquea y cualquier corrección queda visible en un historial de ediciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous pouvez modifier cette fiche pendant 24 heures. Ensuite elle se verrouille, et toute correction reste visible dans un historique des modifications."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आप इस रिकॉर्ड को 24 घंटे तक बदल सकती हैं। उसके बाद यह लॉक हो जाता है, और हर सुधार संपादन इतिहास में दिखता रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kamu bisa mengubah catatan ini selama 24 jam. Setelah itu terkunci, dan setiap koreksi tetap terlihat di riwayat perubahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puoi modificare questa scheda per 24 ore. Poi si blocca e ogni correzione resta visibile in uno storico delle modifiche."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você pode alterar este registro por 24 horas. Depois ele é travado, e qualquer correção fica visível em um histórico de edições."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pode alterar este registo durante 24 horas. Depois fica bloqueado, e qualquer correção fica visível num histórico de edições."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu kaydı 24 saat boyunca değiştirebilirsin. Sonra kilitlenir ve her düzeltme bir düzenleme geçmişinde görünür kalır."
          }
        }
      }
    },
