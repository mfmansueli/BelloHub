    "clientMerge.confirmMessage" : {
      "comment" : "Merge sheet: message of the confirmation dialog. %1$@ is the full name of the profile that is removed, %2$@ the full name of the one that is kept.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تنتقل السجلات والصور والملاحظات من %1$@ إلى %2$@. تتم إزالة ذلك الملف. لا يمكن التراجع عن هذا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Akten, Fotos und Notizen von %1$@ gehen an %2$@. Dieses Profil wird entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records, photos and notes of %1$@ move to %2$@. That profile is removed. This cannot be undone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Records, photos and notes of %1$@ move to %2$@. That profile is removed. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las fichas, fotos y notas de %1$@ pasan a %2$@. Ese perfil se elimina. No se puede deshacer."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las fichas, fotos y notas de %1$@ pasan a %2$@. Ese perfil se elimina. No se puede deshacer."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las fichas, fotos y notas de %1$@ pasan a %2$@. Ese perfil se elimina. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les fiches, photos et notes de %1$@ sont transférées à %2$@. Ce profil est supprimé. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ के रिकॉर्ड, फ़ोटो और नोट %2$@ के पास चले जाएँगे। वह प्रोफ़ाइल हटा दी जाएगी। इसे वापस नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catatan, foto, dan catatan pribadi milik %1$@ pindah ke %2$@. Profil itu dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schede, foto e note di %1$@ passano a %2$@. Quel profilo viene rimosso. Non si può annullare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fichas, fotos e anotações de %1$@ passam para %2$@. Esse perfil é removido. Não é possível desfazer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As fichas, fotografias e notas de %1$@ passam para %2$@. Esse perfil é removido. Não é possível anular."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ profilindeki kayıtlar, fotoğraflar ve notlar %2$@ profiline taşınır. O profil kaldırılır. Bu işlem geri alınamaz."
          }
        }
      }
    },
