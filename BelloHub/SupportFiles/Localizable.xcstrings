    "clientEdit.stop.hint" : {
      "comment" : "Edit screen: what the booking page tells a client whose online booking is stopped. %@ is the professional's first name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تظهر في صفحة الحجز الرسالة: يرجى مراسلة %@ للحجز. المواعيد الحالية لا تتأثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auf Ihrer Buchungsseite steht: Bitte schreiben Sie %@, um zu buchen. Bestehende Termine bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your booking page the message reads: Please message %@ to book. Existing appointments are not touched."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "On your booking page the message reads: Please message %@ to book. Existing appointments are not touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En tu página de reservas se lee: Escribe a %@ para reservar. Las citas existentes no se tocan."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En tu página de reservas se lee: Escribe a %@ para reservar. Las citas existentes no se tocan."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En tu página de reservas se lee: Escribe a %@ para reservar. Las citas existentes no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sur votre page de réservation, le message est : Écrivez à %@ pour réserver. Les rendez-vous existants ne sont pas modifiés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके बुकिंग पेज पर लिखा होता है: बुकिंग के लिए कृपया %@ को मैसेज करें। मौजूदा अपॉइंटमेंट में कोई बदलाव नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Di halaman pemesanan Anda tertulis: Silakan kirim pesan ke %@ untuk memesan. Janji temu yang sudah ada tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nella tua pagina di prenotazione si legge: Scrivi a %@ per prenotare. Gli appuntamenti esistenti non vengono toccati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na sua página de agendamento aparece: Envie uma mensagem para %@ para agendar. Os agendamentos que já existem não são alterados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
