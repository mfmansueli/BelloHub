    "shareLink.whatsapp.text" : {
      "comment" : "Greeting text for a WhatsApp chat. %1$@ is the professional's first name, %2$@ the booking link.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
