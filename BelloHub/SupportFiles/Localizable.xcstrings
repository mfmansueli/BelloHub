    "clientMessage.birthday" : {
      "comment" : "Birthday message to a client, written in the business language. {name} is the client's first name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عيد ميلاد سعيد، {name}! أتمنى لك يومًا جميلًا. متى احتجت إلى عناية، أنا هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alles Gute zum Geburtstag, {name}! Ich wünsche dir einen schönen Tag. Wenn du dir etwas Gutes tun möchtest, bin ich da."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Happy birthday, {name}! Wishing you a lovely day. Whenever you want a little care, I am here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Happy birthday, {name}! Wishing you a lovely day. Whenever you want a little care, I am here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Feliz cumpleaños, {name}! Te deseo un día precioso. Cuando quieras un poco de cuidado, aquí estoy."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Feliz cumpleaños, {name}! Te deseo un día precioso. Cuando quieras un poco de cuidado, aquí estoy."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Feliz cumpleaños, {name}! Te deseo un día precioso. Cuando quieras un poco de cuidado, aquí estoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Joyeux anniversaire, {name} ! Je vous souhaite une belle journée. Quand vous voulez un moment de soin, je suis là."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जन्मदिन मुबारक, {name}! आपका दिन बहुत सुंदर बीते। जब भी थोड़ी देखभाल चाहिए, मैं यहाँ हूँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Selamat ulang tahun, {name}! Semoga harimu menyenangkan. Kapan pun kamu ingin perawatan, aku siap membantu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buon compleanno, {name}! Ti auguro una giornata splendida. Quando vorrai un po' di cura, io sono qui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Feliz aniversário, {name}! Desejo um dia lindo. Quando quiser um cuidado especial, estou aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parabéns, {name}! Desejo-lhe um dia lindo. Quando quiser um momento de cuidado, estou cá."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doğum günün kutlu olsun {name}! Güzel bir gün dilerim. Kendine biraz bakım yaptırmak istediğinde buradayım."
          }
        }
      }
    },
