    "treatmentFlow.camera.denied.message" : {
      "comment" : "Camera denied: explanation",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحتاج Bello إلى الكاميرا لالتقاط الصور. يمكنك السماح بها من الإعدادات، أو إضافة صورة من مكتبتك بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello braucht die Kamera, um Fotos aufzunehmen. Du kannst sie in den Einstellungen erlauben oder stattdessen ein Foto aus deiner Mediathek hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bello needs the camera to take photos. You can allow it in Settings, or add a photo from your library instead."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello needs the camera to take photos. You can allow it in Settings, or add a photo from your library instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello necesita la cámara para hacer fotos. Puedes permitirla en Ajustes o añadir una foto de tu biblioteca."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello necesita la cámara para tomar fotos. Puedes permitirla en Ajustes o agregar una foto de tu biblioteca."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello necesita la cámara para tomar fotos. Puedes permitirla en Ajustes o agregar una foto de tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello a besoin de l’appareil photo pour prendre des photos. Vous pouvez l’autoriser dans Réglages ou ajouter une photo depuis votre photothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "फ़ोटो लेने के लिए Bello को कैमरा चाहिए। आप सेटिंग्स में अनुमति दे सकती हैं, या लाइब्रेरी से फ़ोटो जोड़ सकती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello membutuhkan kamera untuk mengambil foto. Kamu bisa mengizinkannya di Pengaturan, atau tambahkan foto dari pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello ha bisogno della fotocamera per scattare foto. Puoi consentirla in Impostazioni o aggiungere una foto dalla libreria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Bello precisa da câmera para tirar fotos. Você pode permitir em Ajustes ou adicionar uma foto da sua galeria."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Bello precisa da câmara para tirar fotografias. Pode permitir em Definições ou adicionar uma fotografia da sua biblioteca."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello’nun fotoğraf çekmek için kameraya ihtiyacı var. Ayarlar’dan izin verebilir ya da kitaplığından bir fotoğraf ekleyebilirsin."
          }
        }
      }
    },
