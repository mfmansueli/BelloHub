    "clientKnowledge.intro" : {
      "comment" : "Client knowledge screen: explanation. %@ is her first name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ما تريد تذكّره عن %@ بكلماتك. أنت وحدك من يراه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was Sie sich über %@ merken möchten, in Ihren eigenen Worten. Nur Sie sehen das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you want to remember about %@, in your own words. Only you see this."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "What you want to remember about %@, in your own words. Only you see this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo que quieres recordar sobre %@, con tus propias palabras. Solo tú lo ves."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo que quieres recordar sobre %@, con tus propias palabras. Solo tú lo ves."
