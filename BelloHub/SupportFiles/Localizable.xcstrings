    "bookingSettings.guests.subtitle" : {
      "comment" : "Explains guests per booking.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يمكن للعميل اصطحاب صديق أو أحد أقاربه. تكون المواعيد متتالية ويُجمع الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ihre Kundschaft kann eine Begleitung aus dem Freundes- oder Familienkreis mitbringen. Die Termine folgen direkt aufeinander, die Zeit addiert sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A client can bring a friend or a relative. Visits are back to back and the time adds up."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A client can bring a friend or a relative. Visits are back to back and the time adds up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tus clientes pueden venir con una persona amiga o familiar. Las citas van seguidas y el tiempo se suma."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tus clientes pueden venir con una persona amiga o familiar. Las citas van seguidas y el tiempo se suma."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
