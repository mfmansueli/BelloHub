    "shareLink.whatsapp.text" : {
      "comment" : "Greeting text for a WhatsApp chat. %1$@ is the professional's first name, %2$@ the booking link.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مرحبًا! شكرًا على رسالتك. يمكنك الحجز لدى %1$@ من هنا: %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hallo! Danke für Ihre Nachricht. Hier können Sie bei %1$@ buchen: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi! Thanks for your message. You can book with %1$@ here: %2$@"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hi! Thanks for your message. You can book with %1$@ here: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola! Gracias por tu mensaje. Puedes reservar con %1$@ aquí: %2$@"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola! Gracias por tu mensaje. Puedes reservar con %1$@ aquí: %2$@"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola! Gracias por tu mensaje. Puedes reservar con %1$@ aquí: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bonjour ! Merci pour votre message. Vous pouvez réserver avec %1$@ ici : %2$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नमस्ते! आपके संदेश के लिए धन्यवाद। आप %1$@ के साथ यहाँ बुक कर सकते हैं: %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halo! Terima kasih atas pesan Anda. Anda bisa memesan bersama %1$@ di sini: %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ciao! Grazie per il tuo messaggio. Puoi prenotare con %1$@ qui: %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oi! Agradeço a sua mensagem. Você pode agendar com %1$@ aqui: %2$@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Olá! Agradeço a sua mensagem. Pode marcar com %1$@ aqui: %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merhaba! Mesajınız için teşekkürler. %1$@ ile buradan randevu alabilirsiniz: %2$@"
          }
        }
      }
