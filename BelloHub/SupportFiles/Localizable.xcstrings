    "quickReplies.default.confirm.text" : {
      "comment" : "Built-in reply: confirms an appointment. Keep {name} {service} {date} {time} {link} exactly as written; YES is what the client types back, so use the natural word for yes in the language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مرحبًا {name}! أؤكد لك موعد {service} في {date} الساعة {time}. يُرجى الرد بكلمة «نعم» للتأكيد، أو استخدام {link} لتغييره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hallo {name}! Ich bestätige Ihren Termin für {service} am {date} um {time} Uhr. Antworten Sie mit JA, um zu bestätigen, oder ändern Sie ihn über {link}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi {name}! Confirming your {service} on {date} at {time}. Reply YES to confirm or use {link} to change it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hi {name}! Confirming your {service} on {date} at {time}. Reply YES to confirm or use {link} to change it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Te confirmo tu cita de {service} para el {date} a las {time}. Responde SÍ para confirmarla o usa {link} para cambiarla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Te confirmo tu cita de {service} para el {date} a las {time}. Responde SÍ para confirmarla o usa {link} para cambiarla."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Hola, {name}! Te confirmo tu cita de {service} para el {date} a las {time}. Responde SÍ para confirmarla o usa {link} para cambiarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bonjour {name} ! Je vous confirme votre rendez-vous pour {service} : {date} à {time}. Répondez OUI pour confirmer ou utilisez {link} pour le modifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नमस्ते {name}! आपके {service} अपॉइंटमेंट की पुष्टि: {date}, {time} पर। पुष्टि के लिए हाँ लिखकर जवाब दें, या बदलने के लिए {link} का उपयोग करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halo {name}! Konfirmasi janji temu {service} Anda pada {date} pukul {time}. Balas YA untuk mengonfirmasi atau gunakan {link} untuk mengubahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ciao {name}! Ti confermo l'appuntamento per {service}: {date} alle {time}. Rispondi SÌ per confermare oppure usa {link} per modificarlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
