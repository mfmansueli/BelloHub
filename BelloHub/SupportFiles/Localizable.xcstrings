        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सिर्फ़ वही कॉन्टैक्ट पढ़े जाते हैं जो आप चुनते हैं। इम्पोर्ट किए गए के अलावा कुछ भी सहेजा नहीं जाता।"
