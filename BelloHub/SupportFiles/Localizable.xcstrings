    "policy.rule.personalLink" : {
      "comment" : "Client-facing rule line (booking page, confirmation, personal page). The client gets a personal link on the confirmation page, and by email if she gave one (D31: no automatic WhatsApp).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بعد الحجز تحصل على رابط شخصي في صفحة التأكيد، وعلى بريدك الإلكتروني إذا شاركته. استخدمه في أي وقت لإلغاء الموعد أو إعادة جدولته. دون تطبيق أو كلمة مرور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach der Buchung erhalten Sie auf der Bestätigungsseite einen persönlichen Link, bei Angabe einer E-Mail-Adresse auch per E-Mail. Damit können Sie jederzeit absagen oder verschieben. Ohne App und ohne Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you book, you get a personal link on the confirmation page, and by email if you share one. Use it any time to cancel or reschedule. No app or password."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "After you book, you get a personal link on the confirmation page, and by email if you share one. Use it any time to cancel or reschedule. No app or password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al reservar, recibes un enlace personal en la página de confirmación, y por correo si compartes uno. Úsalo cuando quieras para cancelar o cambiar tu cita. Sin app ni contraseña."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al reservar, recibes un enlace personal en la página de confirmación, y por correo si compartes uno. Úsalo cuando quieras para cancelar o reprogramar tu cita. Sin app ni contraseña."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al reservar, recibes un enlace personal en la página de confirmación, y por correo si compartes uno. Úsalo cuando quieras para cancelar o reprogramar tu cita. Sin app ni contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après votre réservation, vous recevez un lien personnel sur la page de confirmation, et par e-mail si vous en indiquez un. Utilisez-le à tout moment pour annuler ou déplacer votre rendez-vous. Sans appli ni mot de passe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बुकिंग के बाद आपको कन्फ़र्मेशन पेज पर एक निजी लिंक मिलता है, और ईमेल देने पर ईमेल से भी। रद्द करने या समय बदलने के लिए इसे कभी भी इस्तेमाल करें। न ऐप चाहिए, न पासवर्ड।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setelah memesan, Anda mendapat tautan pribadi di halaman konfirmasi, dan lewat email jika Anda membagikannya. Gunakan kapan saja untuk membatalkan atau menjadwalkan ulang. Tanpa aplikasi atau kata sandi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dopo la prenotazione ricevi un link personale nella pagina di conferma, e via e-mail se ne indichi una. Usalo quando vuoi per annullare o spostare l'appuntamento. Nessuna app né password."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Depois de agendar, você recebe um link pessoal na página de confirmação e também por e-mail, se informar um. Use-o quando quiser para cancelar ou remarcar. Sem app nem senha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Depois de fazer a marcação, recebe um link pessoal na página de confirmação e também por e-mail, se indicar um. Use-o quando quiser para desmarcar ou remarcar. Sem aplicação nem palavra-passe."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
