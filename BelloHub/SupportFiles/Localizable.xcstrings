        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perubahan tersimpan otomatis. Pemesanan yang sudah dibuat tetap memakai aturan saat dibuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
