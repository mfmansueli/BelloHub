    "health.consent.empty" : {
      "comment" : "Empty state of the consents list.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم تُسجَّل أي موافقة بعد. دوّني هنا ما وقّعته معك؛ تبقى الورقة لديك."
