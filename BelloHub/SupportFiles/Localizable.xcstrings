    "cancelPolicy.footer" : {
      "comment" : "Footnote: changes save by themselves; existing bookings keep their rules.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحفظ التغييرات تلقائيًا. تحتفظ الحجوزات التي تمت بالفعل بالقواعد التي أُجريت بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Änderungen werden automatisch gespeichert. Bereits getätigte Buchungen behalten die Regeln, unter denen sie erstellt wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
