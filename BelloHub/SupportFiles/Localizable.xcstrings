        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No hemos podido leer tus certificados. Comprueba que tu iPhone esté desbloqueado e inténtalo de nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No pudimos leer tus certificados. Revisa que tu iPhone esté desbloqueado e inténtalo de nuevo."
