    "treatmentFlow.camera.needsConsent" : {
      "comment" : "Camera review: photo consent missing",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المشاركة مع العميلة أو استخدام الصورة في معرض الأعمال تتطلب موافقتها على التصوير، وهي غير موقّعة بعد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Teilen mit der Kundin oder die Nutzung im Portfolio setzt ihre Foto-Einwilligung voraus, die noch nicht unterschrieben ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing with the client or using it in a portfolio needs the client’s photo consent, which is not signed yet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sharing with the client or using it in a portfolio needs the client’s photo consent, which is not signed yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compartir con la clienta o usar en el porfolio requiere su consentimiento de fotos, que aún no está firmado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compartir con la clienta o usar en el portafolio requiere su consentimiento de fotos, que aún no está firmado."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compartir con la clienta o usar en el portafolio requiere su consentimiento de fotos, que aún no está firmado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Partager avec la cliente ou utiliser dans un portfolio demande son consentement aux photos, pas encore signé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्लाइंट के साथ साझा करने या पोर्टफ़ोलियो में उपयोग करने के लिए क्लाइंट की फ़ोटो सहमति चाहिए, जो अभी हस्ताक्षरित नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Membagikan ke klien atau memakainya di portofolio memerlukan persetujuan foto klien, yang belum ditandatangani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
