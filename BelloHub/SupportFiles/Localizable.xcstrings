    "treatmentFlow.register.reason.denied" : {
      "comment" : "Register: voice off because the microphone is not allowed",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الميكروفون متوقف لـ Bello. يمكنك تشغيله من الإعدادات، أو ملء النموذج: إنه طريقة كاملة للتسجيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Mikrofon ist für Bello ausgeschaltet. Du kannst es in den Einstellungen einschalten oder das Formular ausfüllen: Das ist eine vollwertige Art zu dokumentieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone is off for Bello. You can turn it on in Settings, or fill in the form: it is a complete way to record."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The microphone is off for Bello. You can turn it on in Settings, or fill in the form: it is a complete way to record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El micrófono está desactivado para Bello. Puedes activarlo en Ajustes o rellenar el formulario: es una forma completa de registrar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El micrófono está desactivado para Bello. Puedes activarlo en Ajustes o llenar el formulario: es una forma completa de registrar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El micrófono está desactivado para Bello. Puedes activarlo en Ajustes o llenar el formulario: es una forma completa de registrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le microphone est désactivé pour Bello. Vous pouvez l’activer dans Réglages ou remplir le formulaire : c’est une façon complète d’enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello के लिए माइक्रोफ़ोन बंद है। आप इसे सेटिंग्स में चालू कर सकती हैं, या फ़ॉर्म भर सकती हैं: यह रिकॉर्ड करने का पूरा तरीका है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mikrofon dinonaktifkan untuk Bello. Kamu bisa menyalakannya di Pengaturan, atau isi formulir: itu cara lengkap untuk mencatat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il microfono è disattivato per Bello. Puoi attivarlo in Impostazioni o compilare il modulo: è un modo completo di registrare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O microfone está desativado para o Bello. Você pode ativar em Ajustes ou preencher o formulário: é um jeito completo de registrar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O microfone está desativado para o Bello. Pode ativá-lo em Definições ou preencher o formulário: é uma forma completa de registar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bello için mikrofon kapalı. Ayarlar’dan açabilir ya da formu doldurabilirsin: bu eksiksiz bir kayıt yoludur."
          }
        }
      }
    },
