rules_version = '2';

// DENY ALL. These are the only rules that may be deployed to the existing Firebase project `bello-hub`
// (ASSUMPTION-1 in docs/PROGRESS.md) until a human creates the dev and staging projects (docs/14-HUMAN-TASKS.md, H4).
// The real rules live in firebase/firestore.rules and are tested on the emulators only.
// A test (functions/test/rules/prod-rules.test.ts) fails if this file ever allows anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
