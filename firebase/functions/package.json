{
  "name": "bellohub-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Bello Hub server: Cloud Functions (2nd gen), the sealed mailbox, the booking rules. Operational data only, never clinical data.",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:rules": "vitest run --project rules",
    "test:transport": "vitest run --project transport",
    "gen:schemas": "tsx scripts/generate-schemas.ts",
    "gen:push-keys": "tsx scripts/generate-push-keys.ts",
    "emulators": "npm run build && firebase emulators:start --project demo-bellohub",
    "seed": "tsx scripts/seed.ts",
    "audit": "npm audit --audit-level=high"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "firebase": "^13.0.0",
    "globals": "^17.13.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
