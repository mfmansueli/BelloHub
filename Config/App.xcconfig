// App.xcconfig
// The BelloHub app target. Shared settings come from Project.xcconfig.

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.bellohub
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = BelloHub/SupportFiles/BelloHub.entitlements
// App Attest (Firebase App Check) is a development environment in Debug and production everywhere else.
APP_ATTEST_ENVIRONMENT = production
APP_ATTEST_ENVIRONMENT[config=Debug] = development
DEVELOPMENT_TEAM = X5392U638Q

// App icon: the Icon Composer package BelloHub/SupportFiles/BelloHub.icon (layers, light/dark/tinted appearances).
// Minimum iOS 26, so no legacy AppIcon set is needed.
ASSETCATALOG_COMPILER_APPICON_NAME = BelloHub

ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = @executable_path/Frameworks
SWIFT_EMIT_LOC_STRINGS = YES

// MARK: - Server addresses (read by ServerConfig through Config/App-Info.plist)
// `//` starts a comment in an xcconfig, so the scheme separator is written `/$()/`. D54: the link base is the Firebase
// Hosting address until a custom domain exists. Functions are the dev project's `bello-hub` in europe-west1.
BELLO_FUNCTIONS_BASE_URL = https:/$()/europe-west1-bello-hub.cloudfunctions.net
BELLO_WEB_BASE_URL = https:/$()/bello-hub.web.app
// The Firestore project the inbox reads from (bookings, requests, waitlist, sealed items), with the same rules.
BELLO_FIREBASE_PROJECT_ID = bello-hub

// MARK: - Generated Info.plist

GENERATE_INFOPLIST_FILE = YES
// Array keys (localizations, background modes) that INFOPLIST_KEY_* cannot express.
INFOPLIST_FILE = Config/App-Info.plist
// Export compliance: the app only uses exempt encryption (HTTPS and what the OS provides), so
// App Store Connect and Xcode Cloud stop asking about it on every build.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_CFBundleDisplayName = Bello Hub
// Usage descriptions (localized in InfoPlist.xcstrings; these are the English fallbacks the system shows first).
INFOPLIST_KEY_NSFaceIDUsageDescription = To unlock your clients and records.
INFOPLIST_KEY_NSMicrophoneUsageDescription = To record treatment notes by voice.
INFOPLIST_KEY_NSCameraUsageDescription = To take treatment photos.
INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription = To show your appointments in a Bello Hub calendar on this iPhone.
INFOPLIST_KEY_NSContactsUsageDescription = To import the clients you choose.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIStatusBarStyle = UIStatusBarStyleDefault
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
