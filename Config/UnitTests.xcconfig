// UnitTests.xcconfig
// BelloHubTests: Swift Testing, hosted in the app so `@testable import BelloHub` works.

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.iagoxavierdelima.BelloHubTests
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = X5392U638Q

GENERATE_INFOPLIST_FILE = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
TEST_HOST = $(BUILT_PRODUCTS_DIR)/BelloHub.app/BelloHub
BUNDLE_LOADER = $(TEST_HOST)
